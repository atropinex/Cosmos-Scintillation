{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node", "vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "scripts/preload/**/*.ts",
    "scripts/common/**/*.ts",
    "scripts/ui/mainindex.ts",
    "scripts/vite-env.d.ts",
    "tools/**/*.ts"
  ]
}
